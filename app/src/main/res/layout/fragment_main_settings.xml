<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- General Settings Section -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_general" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsSectionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.alibaba.mnnllm.android.modelsettings.SettingsItemView
                    android:id="@+id/item_stop_download"
                    style="@style/SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:itemText="@string/stop_download_tasks_when_chat" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <com.alibaba.mnnllm.android.modelsettings.SettingsItemView
                    android:id="@+id/item_ai_safety_filter"
                    style="@style/SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:itemText="@string/ai_safety_filter_title"
                    app:itemSummary="@string/ai_safety_filter_summary" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <com.alibaba.mnnllm.android.modelsettings.SettingsItemView
                    android:id="@+id/item_agent_mode"
                    style="@style/SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:itemText="@string/agent_mode_title"
                    app:itemSummary="@string/agent_mode_summary" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <com.alibaba.mnnllm.android.modelsettings.SettingsItemView
                    android:id="@+id/item_direct_reply"
                    style="@style/SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:itemText="@string/direct_mode_title"
                    app:itemSummary="@string/direct_mode_summary" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <!-- HNN CN ET v1.1.0: inline expandable MCP panel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:id="@+id/row_mcp_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mcp_config_title"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mcp_config_summary"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="13sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_mcp_enable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/panel_mcp_servers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:id="@+id/list_mcp_servers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mcp_add"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/mcp_add" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <com.alibaba.mnnllm.android.modelsettings.DropDownLineView
                    android:id="@+id/dropdown_download_provider"
                    style="@style/SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:icon="@drawable/baseline_arrow_drop_down_24"
                    app:labelText="@string/select_download_provider" />


                <TextView
                    android:id="@+id/btn_voice_model_management"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/voice_model_management" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/btn_storage_management"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/storage_management" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/btn_import_model"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/import_model" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- HNN CN ET v1.0.9: Theme & Appearance Section -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_appearance" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsSectionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsRowClickable"
                    android:id="@+id/row_theme_mode"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_theme_mode" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    style="@style/SettingsRowClickable"
                    android:id="@+id/row_theme_color"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_theme_color" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    style="@style/SettingsRowClickable"
                    android:id="@+id/row_wallpaper"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_wallpaper" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- API Settings Section -->
        <TextView
            android:id="@+id/header_api_settings"
            style="@style/SettingsSectionHeader"
            android:text="@string/api_settings" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/api_settings_card"
            style="@style/SettingsSectionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.alibaba.mnnllm.android.modelsettings.SettingsItemView
                    android:id="@+id/item_enable_api"
                    style="@style/SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:itemText="@string/enable_api_service" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/btn_reset_api"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/reset_api_config" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/btn_direct_run_model"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/direct_run_model" />

                <TextView
                    android:id="@+id/btn_api_endpoint_info"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/api_endpoint_info" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About Section -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/about" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsSectionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.alibaba.mnnllm.android.modelsettings.SettingsItemView
                    android:id="@+id/item_crash_diagnostics"
                    style="@style/SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:itemText="@string/crash_diagnostics_enabled_title" />

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider_debug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btn_debug_mode"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/debug_mode"
                    android:visibility="gone" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/mnn_version" />

                    <TextView
                        android:id="@+id/tv_mnn_version"
                        style="@style/SettingsRowValue"
                        tools:text="3.0.0" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/btn_check_update"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/check_for_update" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/btn_contact_author"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/contact_author" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/btn_join_qq_group"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/join_qq_group" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/btn_view_logs"
                    style="@style/SettingsRowClickable"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/feedback_logs" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
